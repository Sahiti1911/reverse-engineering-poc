{
  "name": "coverage-gap-analysis",
  "version": "1.0.0",
  "description": "Reusable test-coverage gap analysis: Jira stories + source code vs Zephyr Scale, reported to Excel with reasoning and token usage",
  "type": "module",
  "private": true,
  "scripts": {
    "coverage": "node scripts/run.mjs",
    "create-approved": "node scripts/create-approved.mjs",
    "test": "node --test \"test/*.test.mjs\" && npm --prefix zephyr_mcp test",
    "ui-login": "node scripts/ui-login.mjs",
    "agents": "node scripts/agents.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "node-html-parser": "^7.0.1",
    "yaml": "^2.9.1"
  }
}
