# Copy to .env (or .env.local) next to package.json, or pass these through the
# "env" block of the .mcp.json entry. Variables already set in the environment win.

# Required
ZEPHYR_API_TOKEN=

# Optional
ZEPHYR_PROJECT_KEY=QA
# "true" uses the EU base URL (https://eu.api.zephyrscale.smartbear.com/v2)
ZEPHYR_EU_REGION=true

# Optional: lets link_test_case_to_issue accept a Jira issue key (e.g. AVLN-2398)
# and resolve it to the numeric issue id.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
