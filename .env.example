# Copy to .env (or .env.local). zephyr_mcp/.env is read as a fallback, so values
# already there do not need to be repeated.

# Zephyr Scale Cloud API token (Zephyr > API Access Tokens)
ZEPHYR_API_TOKEN=

# Jira REST (read) for the scripted story fetch; https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Optional: path to the claude CLI if it is not on PATH (auto-detected from the VS Code extension otherwise)
CLAUDE_BIN=
