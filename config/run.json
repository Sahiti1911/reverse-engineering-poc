{
  "defaultProfile": "avl",
  "defaultModule": "grid export",
  "claude": {
    "bin": "auto",
    "timeoutMs": 900000,
    "retries": 1,
    "maxTokensPerRun": 3000000
  },
  "models": {
    "triage": "claude-haiku-5-5",
    "extract-ac": "claude-sonnet-5-5",
    "extract-code": "claude-sonnet-5-5",
    "match": "claude-opus-5-5",
    "draft": "claude-sonnet-5-5"
  },
  "concurrency": 3,
  "batch": {
    "triage": 40,
    "extract-ac": 6,
    "draft": 12
  },
  "limits": {
    "descriptionCharsTriage": 1200,
    "descriptionCharsExtract": 8000,
    "codeBytesPerModule": 300000,
    "candidateCasesPerStory": 40,
    "keywordCandidates": 12,
    "moduleCandidates": 15,
    "folderCandidates": 15
  },
  "matching": {
    "autoAcceptConfidence": [
      "High"
    ]
  },
  "code": {
    "enabled": true,
    "skipForUcDocStories": false,
    "discovery": {
      "maxDepth": 3,
      "maxSpread": 8,
      "maxHits": 3,
      "maxCallers": 150,
      "variantSamples": 3,
      "extraTokens": [],
      "keywordSweep": {
        "enabled": true,
        "maxSeedsPerPhrase": 25,
        "maxMentions": 60
      }
    }
  },
  "zephyr": {
    "exportMaxAgeHours": 12,
    "stepsMaxAgeHours": 168
  },
  "agents": {
    "model": {
      "default": "sonnet",
      "reporter": "haiku"
    },
    "timeoutMs": 1800000
  }
}
